# Copy to .env.local and fill in values you need.
# .env.local is gitignored; never commit real secrets.

# --- Mode ---
# Omit or set to "local" for SQLite. Set "cloud" for Postgres + Auth.
# DEPLOYMENT_MODE=local
# DEPLOYMENT_MODE=cloud

# --- Local / self-hosted (SQLite) ---
# Optional. Defaults to ./money-watch.db (browser) or Money-Watch under app data (Electron).
# DATABASE_PATH=./money-watch.db

# --- Cloud auth (DEPLOYMENT_MODE=cloud only) ---
# Omit or "supabase" (default) for Supabase Auth. Set "simple" for static email/password
# accounts with no external provider — see docs/adr/0015-simple-email-password-auth-as-supabase-alternative.md.
# AUTH_PROVIDER=simple

# --- Supabase Auth — required when AUTH_PROVIDER is unset or "supabase" ---
# Project URL and publishable (anon) key from Supabase → Project Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Cloudflare Turnstile site key for email/password sign-in, sign-up, and recovery (Supabase Auth).
# Create a widget at https://dash.cloudflare.com/ → Turnstile. Put the *secret* only in
# Supabase → Authentication → Attack Protection / Captcha (Turnstile) — never here.
# Without this site key, email/password and recovery forms are hidden; Google sign-in can still appear.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...

# --- Simple auth — required when AUTH_PROVIDER=simple ---
# Comma-separated email:password accounts. No sign-up UI, no users table. Each email is its
# own isolated Owner. No password reset; edit this list and redeploy. Passwords may not contain ',' or ':'.
# AUTH_USERS=owner1@example.com:pass1,owner2@example.com:pass2

# Postgres for migrations and server access — any Postgres, not only Supabase.
# On Supabase, prefer the Session pooler URI (port 5432), not the direct db.* host or Transaction pooler (6543).
# POSTGRES_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Required in cloud once any Owner configures Email Alert Sync — encrypts IMAP username/password
# at rest (docs/adr/0012-imap-credentials-encrypted-at-rest-with-app-layer-key.md).
# Base64-encoded 32 bytes (AES-256). Generate with: openssl rand -base64 32
# Losing this key makes saved IMAP credentials unrecoverable — back it up like any other secret.
# EMAIL_SYNC_ENCRYPTION_KEY=

# Vercel Cron auth for /api/cron/email-sync (cloud). Required in production; local cloud
# can use any string of at least 32 characters for manual curl tests (openssl rand -hex 32).
# CRON_SECRET=
